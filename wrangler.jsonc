{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ugne-portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve index.html for client-side routes like /about
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "sipasoftware.com", "custom_domain": true }
  ]
}
